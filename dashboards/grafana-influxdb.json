              { "color": "#F59E0B", "value": 50 },
              { "color": "#10B981", "value": 80 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
